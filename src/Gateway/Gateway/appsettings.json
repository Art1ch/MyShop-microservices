{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Debug"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "userapi-cluster",
        "Match": {
          "Path": "/api/User/{**catch-all}"
        }
      },
      "store-route": {
        "ClusterId": "storeapi-cluster",
        "Match": {
          "Path": "/api/Store/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "orderapi-cluster",
        "Match": {
          "Path": "/api/Order/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "userapi-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://host.docker.internal:5000/"
          }
        }
      },
      "storeapi-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://host.docker.internal:5002/"
          }
        }
      },
      "orderapi-cluster": {
        "Destinations": {
          "destination1": {            "Address": "http://host.docker.internal:5004/"
          }
        }
      }
    }
  },

  "AllowedHosts": "*"
}
